{
  "name": "bsn-acquaintance-root",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "build": "npm --prefix frontend run build && node -e \"require('fs').cpSync('frontend/dist', 'dist', {recursive: true})\"",
    "preview": "npm --prefix frontend run preview"
  },
  "workspaces": [
    "frontend",
    "backend"
  ]
}
